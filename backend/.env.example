# Copy to .env and fill in real values. .env is gitignored.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CENRO TROID <no-reply@troid.local>

# Centralized database (Supabase Postgres). Leave unset to fall back to
# local db.sqlite3. Get this from the Supabase dashboard: Project Settings
# -> Database -> Connection string -> URI. With a single gunicorn worker
# (see railway.toml) the direct connection on port 5432 is simplest; only
# switch to the "Transaction pooler" (port 6543) if you later scale to
# multiple workers/instances, and set conn_max_age=0 in settings.py if so
# (pgbouncer's transaction mode doesn't play well with persistent connections).
# postgresql://postgres:[password]@[host]:5432/postgres
# DATABASE_URL=

# Cloudflare Worker realtime relay (see cloudflare-ws/).
REALTIME_WORKER_URL=http://127.0.0.1:8787
REALTIME_WORKER_SECRET=dev-shared-secret-change-me
