# Copy to .env and fill in real values. .env is gitignored.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CENRO TROID <no-reply@troid.local>

# Centralized database. Leave unset to fall back to local db.sqlite3.
# Postgres connection string, e.g. postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# Cloudflare Worker realtime relay (see cloudflare-ws/).
REALTIME_WORKER_URL=http://127.0.0.1:8787
REALTIME_WORKER_SECRET=dev-shared-secret-change-me
