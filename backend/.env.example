# Copy to .env and fill in real values. .env is gitignored.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CENRO TROID <no-reply@troid.local>

# Render's free plan blocks outbound SMTP, so in production relay email
# through the Cloudflare Worker below (it holds the Gmail address and app
# password as its SMTP_USER / SMTP_PASS secrets):
# EMAIL_BACKEND=troid_api.email_backends.WorkerEmailBackend

# Centralized database (Supabase Postgres). Leave unset to fall back to
# local db.sqlite3. Get this from the Supabase dashboard: Connect ->
# Connection string -> URI, using the "Session pooler" option (port 5432 on
# *.pooler.supabase.com). Render can't reach Supabase's direct connection
# (db.<ref>.supabase.co is IPv6-only), and the session pooler works with the
# persistent connections settings.py uses. Avoid the Transaction pooler
# (port 6543) unless you also set conn_max_age=0.
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=

# Supabase REST API access for the mobile app's task status updates.
# Use the project URL and keep the secret key only in this backend environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# API permissions. Unset or False: requests that would be refused are only
# logged as "[auth] would deny ..." and allowed. True: they are refused.
# API_AUTH_ENFORCED=True

# Cloudflare Worker realtime relay (see cloudflare-ws/).
REALTIME_WORKER_URL=http://127.0.0.1:8787
REALTIME_WORKER_SECRET=dev-shared-secret-change-me
