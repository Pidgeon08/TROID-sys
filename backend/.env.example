# Copy to .env and fill in real values. .env is gitignored.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CENRO TROID <no-reply@troid.local>

# Render's free plan blocks outbound SMTP, so in production send via Brevo's
# HTTPS API instead (DEFAULT_FROM_EMAIL must be a sender verified in Brevo):
# EMAIL_BACKEND=troid_api.email_backends.BrevoEmailBackend
# BREVO_API_KEY=

# Centralized database (Supabase Postgres). Leave unset to fall back to
# local db.sqlite3. Get this from the Supabase dashboard: Connect ->
# Connection string -> URI, using the "Session pooler" option (port 5432 on
# *.pooler.supabase.com). Render can't reach Supabase's direct connection
# (db.<ref>.supabase.co is IPv6-only), and the session pooler works with the
# persistent connections settings.py uses. Avoid the Transaction pooler
# (port 6543) unless you also set conn_max_age=0.
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=

# Cloudflare Worker realtime relay (see cloudflare-ws/).
REALTIME_WORKER_URL=http://127.0.0.1:8787
REALTIME_WORKER_SECRET=dev-shared-secret-change-me
